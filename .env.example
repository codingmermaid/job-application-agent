# Copy to .env and fill in. Never commit .env.

# Free key: https://aistudio.google.com/apikey (no billing needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is busy, rate limited or slow
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite
# Minimum seconds between LLM calls, to stay under free-tier rate limits
LLM_MIN_INTERVAL_S=4

# Where the app keeps its databases (default: ./var)
# JOBAGENT_DATA_DIR=var
